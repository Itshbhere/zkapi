# Public deployment metadata; replace all placeholders with the fresh deployment.
CIRCUIT_ID=zkapi-v2-note-bound-v1
CHAIN_ID=11155111
VAULT_ADDRESS=REPLACE_WITH_FRESH_VAULT_ADDRESS
DEPLOY_BLOCK=REPLACE_WITH_VAULT_DEPLOYMENT_BLOCK
REQUEST_CHARGE_CAP=50000
LEASE_TTL_SECONDS=300
SETTLEMENT_GRACE_SECONDS=5
CHALLENGE_CONFIRMATIONS=2
RUST_LOG=info
# Set only for verifier-backed OA-org leases (mutually exclusive with a direct
# OpenRouter management credential in server.env).
# OA_ORG_URL=https://org.example

# Native ETH ledger: integer gwei. Pin the feed/RPC to the selected chain.
ZKAPI_NATIVE_BILLING_RPC_URL=REPLACE_WITH_CHAIN_RPC_URL
ZKAPI_NATIVE_PRICE_FEED_ADDRESS=REPLACE_WITH_CHAIN_ETH_USD_FEED
ZKAPI_NATIVE_PRICE_FEED_DECIMALS=8
ZKAPI_NATIVE_PRICE_MAX_AGE_SECONDS=4500
