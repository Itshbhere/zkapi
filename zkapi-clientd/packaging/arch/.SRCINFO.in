pkgbase = zkapi-clientd-bin
	pkgdesc = Local inference API with private prepaid zkAPI access
	pkgver = @@VERSION@@
	pkgrel = 1
	url = https://github.com/OpenAnonymity/zkapi
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = ca-certificates
	depends = glibc>=2.39
	depends = gcc-libs
	depends = openssl>=3
	optdepends = systemd: user service management
	options = !strip
	provides = zkapi-clientd
	conflicts = zkapi-clientd
	source_x86_64 = zkapi-clientd_@@VERSION@@_linux_amd64.tar.gz::@@BASE_URL@@/zkapi-clientd_@@VERSION@@_linux_amd64.tar.gz
	sha256sums_x86_64 = @@LINUX_AMD64_SHA256@@
	source_aarch64 = zkapi-clientd_@@VERSION@@_linux_arm64.tar.gz::@@BASE_URL@@/zkapi-clientd_@@VERSION@@_linux_arm64.tar.gz
	sha256sums_aarch64 = @@LINUX_ARM64_SHA256@@

pkgname = zkapi-clientd-bin
